{
  "name": "red-horizon-rts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A single-player real-time strategy game for the browser: build a base, mine ore and fight computer opponents on isometric maps.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5199",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
